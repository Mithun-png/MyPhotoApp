# ==========================================
# Root .gitignore for PhotoSharingPlatform
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
!.env.example
!**/.env.example

# Dependencies
node_modules/
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/

# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Frontend build artifacts
frontend/dist/
frontend/dist-ssr/
frontend/coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
